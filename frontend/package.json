{
  "name": "@zappzarapp/devtoolbar-frontend",
  "version": "0.0.0",
  "description": "Browser bundle build pipeline for zappzarapp/devtoolbar (PHP package). Not published to npm; consumed only via the bundled assets/devtoolbar.js.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx devtoolbar.build.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint '**/*.ts' --max-warnings=0",
    "lint:fix": "eslint '**/*.ts' --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@zappzarapp/browser-utils": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.1"
}
