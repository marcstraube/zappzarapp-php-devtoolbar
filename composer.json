{
  "name": "zappzarapp/devtoolbar",
  "description": "In-app developer toolbar for PHP applications: timeline, query analyzer, HTTP/cache collectors, exception tracking, request history. Ships the JS UI as a bundled asset (symfony/web-profiler-bundle pattern).",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "developer-toolbar",
    "debug-bar",
    "profiler",
    "performance",
    "n-plus-one",
    "timeline",
    "monolog",
    "psr-3",
    "php8"
  ],
  "authors": [
    {
      "name": "Marc Straube",
      "email": "email@marcstraube.de"
    }
  ],
  "homepage": "https://github.com/marcstraube/zappzarapp-php-devtoolbar",
  "support": {
    "issues": "https://github.com/marcstraube/zappzarapp-php-devtoolbar/issues",
    "source": "https://github.com/marcstraube/zappzarapp-php-devtoolbar"
  },
  "require": {
    "php": "^8.4",
    "monolog/monolog": "^3.0",
    "zappzarapp/security": "^1.0"
  },
  "suggest": {
    "ext-redis": "Required when CacheCollector is wired to a Redis backend",
    "ext-curl": "Required when HttpClientCollector tracks cURL-based HTTP clients"
  },
  "require-dev": {
    "captainhook/captainhook": "*",
    "captainhook/plugin-composer": "^5.3",
    "cyclonedx/cyclonedx-php-composer": "^6.1",
    "deptrac/deptrac": "^4.5",
    "ekino/phpstan-banned-code": "^3.0",
    "friendsofphp/php-cs-fixer": "^3.91",
    "infection/infection": "*",
    "phpmd/phpmd": "^2.15",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^13.0",
    "rector/rector": "^2.3",
    "roave/security-advisories": "dev-latest",
    "vimeo/psalm": "^6.14"
  },
  "config": {
    "allow-plugins": {
      "captainhook/plugin-composer": true,
      "cyclonedx/cyclonedx-php-composer": true,
      "infection/extension-installer": true
    },
    "platform": {
      "php": "8.4.3"
    }
  },
  "autoload": {
    "psr-4": {
      "Zappzarapp\\DevToolbar\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Zappzarapp\\DevToolbar\\Tests\\": "tests/",
      "Zappzarapp\\DevToolbar\\Tools\\": "tools/"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit",
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=512M",
    "phpmd": "@php vendor/bin/phpmd src text phpmd.xml",
    "rector": "@php vendor/bin/rector process --dry-run",
    "rector-fix": "@php vendor/bin/rector process",
    "deptrac": "@php vendor/bin/deptrac analyse",
    "infection": "@php vendor/bin/infection --threads=4",
    "sbom": "@composer CycloneDX:make-sbom --omit=dev --output-file=sbom.json",
    "docs": "@php build/bin/phpDocumentor.phar",
    "cs-fix": "@php vendor/bin/php-cs-fixer fix",
    "cs-check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
    "psalm": "@php vendor/bin/psalm --show-info=false",
    "psalm-taint": "@php vendor/bin/psalm --taint-analysis",
    "security": "composer audit --no-dev",
    "check": [
      "@security",
      "@cs-check",
      "@analyse",
      "@psalm",
      "@phpmd",
      "@rector",
      "@deptrac",
      "@test"
    ],
    "check-full": [
      "@check",
      "@infection",
      "@psalm-taint"
    ]
  }
}
